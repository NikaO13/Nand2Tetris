// File name: projects/01/Xor.hdl

/**
 * Exclusive-or gate:
 * out = not (a == b)
 */

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
	Nand(a = a, b = b, out = ANandB);
	Nand(a = ANandB, b = a, out = x1);
	Nand(a = ANandB, b = b, out = x2);
	Nand(a = x1, b = x2, out = out);
}
