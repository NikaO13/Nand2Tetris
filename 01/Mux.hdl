// File name: projects/01/Mux.hdl

/** 
 * Multiplexor:
 * out = a if sel == 0
 *       b otherwise
 */

CHIP Mux {
    IN a, b, sel;
    OUT out;

	PARTS:
	Nand(a = sel, b = sel, out = notS);
	Nand(a = a, b = notS, out = x1);
	Nand(a = b, b = sel, out = x2);
	Nand(a = x1, b = x2, out = out);
}
